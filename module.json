{
  "id": "piston",
  "name": "PISTON",
  "abbrev": "PISTON",
  "version": "0.2.2",
  "description": "Live kick + hi-hat drum voice for industrial techno: analog/digital hybrid kick, four analog hat models, two 8-step pad sequencers",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "dsp.so",
  "ui_chain": "ui_chain.js",
  "component_type": "sound_generator",
  "capabilities": {
    "component_type": "sound_generator",
    "chainable": true,
    "audio_in": false,
    "audio_out": true,
    "midi_in": true,
    "midi_out": false,
    "chain_params": [
      {"key": "k_vol",    "name": "Kick Volume", "short_name": "K VOL", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.8},
      {"key": "k_mix",    "name": "Kick A/D Mix", "short_name": "K MIX", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.25},
      {"key": "k_decay",  "name": "Kick Decay",  "short_name": "K DEC", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"key": "k_drive",  "name": "Kick Drive",  "short_name": "K DRV", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.15},
      {"key": "k_comp",   "name": "Kick Comp",   "short_name": "K CMP", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.25},
      {"key": "k_rumble", "name": "Kick Rumble", "short_name": "K RMB", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0},
      {"key": "k_verb",   "name": "Kick Reverb", "short_name": "K VRB", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0},
      {"key": "h_vol",    "name": "Hat Volume",  "short_name": "H VOL", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7},
      {"key": "h_color",  "name": "Hat Metal",   "short_name": "H MTL", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"key": "h_decay",  "name": "Hat Decay",   "short_name": "H DEC", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.25},
      {"key": "h_drive",  "name": "Hat Drive",   "short_name": "H DRV", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.1},
      {"key": "h_comp",   "name": "Hat Comp",    "short_name": "H CMP", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.2},
      {"key": "h_filter", "name": "Hat Filter",  "short_name": "H FLT", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5},
      {"key": "h_verb",   "name": "Hat Reverb",  "short_name": "H VRB", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0}
    ]
  }
}
