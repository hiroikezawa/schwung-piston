{
  "title": "PISTON",
  "children": [
    {
      "title": "Pads",
      "lines": [
        "Top-right pad cycles",
        "KICK > HAT > RACK.",
        "Row 1: MUTE RESET SHUF",
        "  RAND FILL + 2 select",
        "Row 2: 8 presets"
      ]
    },
    {
      "title": "Steps",
      "lines": [
        "8 steps: bottom row.",
        "16 steps: row 3 = 1-8,",
        "  row 4 = 9-16.",
        "Jog to page 2, click",
        "to switch 8 / 16."
      ]
    },
    {
      "title": "Selectors",
      "lines": [
        "Row 1 pads 6-7.",
        "KICK: ANALOG, DIGITAL",
        "  hold + step 1-4",
        "HAT: MODEL (hold),",
        "  OFFBEAT"
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "Row 2, kick and hat",
        "have 8 each.",
        "Tap = recall",
        "Shift+tap = save",
        "Sound + pattern."
      ]
    },
    {
      "title": "Rack",
      "lines": [
        "24 pads, 6 cols x 4.",
        "Hold pad: other half",
        "  = its steps.",
        "Hold + any knob = vol",
        "Mute btn + pad = mute"
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "1 VOL 2 MIX/METAL",
        "3 DECAY 4 DRIVE 5 COMP",
        "6 RUMBLE / FILTER",
        "7 REVERB  8 reserved",
        "Touch = big readout"
      ]
    },
    {
      "title": "Hat decay motion",
      "lines": [
        "HAT surface, touch k3:",
        "records DECAY per step",
        "while your finger is on.",
        "Blue step = open hat.",
        "Hat RESET clears it."
      ]
    },
    {
      "title": "Samples",
      "lines": [
        "Digital kicks: own WAVs",
        "UserLibrary/Samples/",
        "Piston/kick1..4.wav",
        "Restart Move after",
        "adding or updating."
      ]
    },
    {
      "title": "Rack samples",
      "lines": [
        "UserLibrary/Samples/",
        "Piston/Rack/",
        "  01.wav .. 24.wav",
        "Restart Move after",
        "adding or updating."
      ]
    }
  ]
}
