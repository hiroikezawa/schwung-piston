{
  "title": "PISTON",
  "children": [
    {
      "title": "Pads",
      "lines": [
        "Knob 8 turns the page",
        "KICK > HAT > RACK.",
        "Row 1: MUTE RESET SHUF",
        "  RAND FILL + 2 select",
        "Row 2: 8 presets"
      ]
    },
    {
      "title": "Steps",
      "lines": [
        "8 steps: bottom row.",
        "16 steps: row 3 = 1-8,",
        "  row 4 = 9-16.",
        "Jog to page 2, click",
        "to switch 8 / 16."
      ]
    },
    {
      "title": "Selectors",
      "lines": [
        "Row 1 pads 6-7.",
        "KICK: ANALOG, DIGITAL",
        "  hold + step 1-4",
        "HAT: MODEL (hold),",
        "  OFFBEAT"
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "Row 2, kick and hat",
        "have 8 each.",
        "Tap = recall",
        "Shift+tap = save",
        "Sound + pattern."
      ]
    },
    {
      "title": "Rack",
      "lines": [
        "32 pads, 8 cols x 4.",
        "Hold pad: other half",
        "  = its steps.",
        "Hold + knob 1 = vol",
        "Hold + knob 2 = DLY",
        "Hold + knob 3 = REV",
        "Shift + pad = mute"
      ]
    },
    {
      "title": "Rack delay",
      "lines": [
        "Knob 7: DELAY FB",
        "Dotted 1/8, tempo",
        "  synced, rack only.",
        "0 = no delay."
      ]
    },
    {
      "title": "Rack sidechain",
      "lines": [
        "Knob 6: SIDECHAIN",
        "  each kick ducks",
        "  the rack (and its",
        "  delay), then it",
        "  comes back.",
        "0 = off."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "1 VOL 2 MIX/METAL",
        "3 DECAY 4 DRIVE 5 COMP",
        "6 RUMBLE / FILTER",
        "7 REVERB  8 PAGE",
        "Touch = big readout"
      ]
    },
    {
      "title": "Page 2 FX",
      "lines": [
        "Turn the jog: page 2",
        "of KICK / HAT / RACK.",
        "Jog click: 8/16 steps",
        "All FX start OFF.",
        "",
        "KICK FX (kick only)",
        "1 SAT  2 DRIVE",
        " tube on the whole",
        " kick, sub included",
        "",
        "HAT FX (hat only)",
        "1 HARM  2 FREQ",
        " 1.9k 2.8k 6.6k 9.8k",
        "",
        "BUS COMP (RACK pg2)",
        " whole PISTON out",
        "1 THRSH 2 RATIO",
        "3 ATK 4 REL 5 SCHPF",
        "6 MKUP 7 PUNCH",
        "RATIO OFF = bypass",
        "GR shown top right",
        "PUNCH ON*: limiting"
      ]
    },
    {
      "title": "Hat decay motion",
      "lines": [
        "HAT surface, touch k3:",
        "records DECAY per step",
        "while your finger is on.",
        "Blue step = open hat.",
        "Hat RESET clears it."
      ]
    },
    {
      "title": "Samples",
      "lines": [
        "Digital kicks: own WAVs",
        "UserLibrary/Samples/",
        "Piston/kick1..4.wav",
        "Restart Move after",
        "adding or updating."
      ]
    },
    {
      "title": "Rack samples",
      "lines": [
        "UserLibrary/Samples/",
        "Piston/Rack/",
        "  01.wav .. 32.wav",
        "Restart Move after",
        "adding or updating."
      ]
    }
  ]
}
